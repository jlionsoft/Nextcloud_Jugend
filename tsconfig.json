{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": false,
		"noImplicitAny": false,
		"jsx": "preserve",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"baseUrl": "."
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "webpack.config.js"]
}
